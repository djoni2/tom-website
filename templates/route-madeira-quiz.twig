<script>
  (function () {
    var root = document.querySelector('[data-quiz]');
    if (!root) return;
    var pool = JSON.parse(document.getElementById('quiz-data').textContent);
    var perRound = Math.min(+root.dataset.perRound, pool.length);
    var holder = root.querySelector('[data-quiz-cards]');
    var result = root.querySelector('[data-quiz-result]');
    var wrongLines = ['Not quite. Try again.', 'Not this one. Have another go.', 'Close, but no. Pick again.'];
    var cards, current, score;

    function shuffle(list) {
      var a = list.slice();
      for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = a[i]; a[i] = a[j]; a[j] = t;
      }
      return a;
    }

    function el(tag, cls, text) {
      var n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    }

    function show(node) {
      node.hidden = false;
      node.classList.remove('is-entering');
      void node.offsetWidth; // restart the entrance animation
      node.classList.add('is-entering');
      var focusable = node.querySelector('.quiz__option, .quiz__next');
      if (focusable) focusable.focus({ preventScroll: true });
    }

    function buildCard(item, index) {
      var answer = item.o[0];
      var card = el('section', 'quiz__card');
      card.hidden = true;
      card.setAttribute('aria-labelledby', 'quiz-q' + index);

      var count = el('div', 'quiz__count');
      count.appendChild(el('span', 'quiz__count-num', String(index + 1).padStart(2, '0')));
      count.appendChild(el('span', 'quiz__count-total', '/' + perRound));
      var track = el('div', 'quiz__progress');
      var fill = el('div', 'quiz__progress-fill');
      fill.style.width = (((index + 1) / perRound) * 100) + '%';
      track.appendChild(fill);
      count.appendChild(track);
      var question = el('h2', 'quiz__question', item.q);
      question.id = 'quiz-q' + index;
      var list = el('ol', 'quiz__options list-reset');
      var feedback = el('p', 'quiz__feedback');
      feedback.setAttribute('role', 'status');
      feedback.setAttribute('aria-live', 'polite');
      var actions = el('div', 'quiz__actions');
      var next = el('button', 'quiz__next', index === perRound - 1 ? 'See your result ' : 'Next question ');
      next.type = 'button';
      next.hidden = true;
      next.insertAdjacentHTML('beforeend', '<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');
      actions.appendChild(next);

      var tries = 0;
      shuffle(item.o).forEach(function (option, i) {
        var li = el('li');
        var btn = el('button', 'quiz__option');
        btn.type = 'button';
        btn.appendChild(el('span', 'quiz__letter', 'ABCDEFGH'.charAt(i))).setAttribute('aria-hidden', 'true');
        btn.appendChild(el('span', 'quiz__label', option));
        btn.addEventListener('click', function () {
          if (card.classList.contains('is-solved') || btn.disabled) return;
          if (option === answer) {
            card.classList.add('is-solved');
            btn.classList.add('is-correct');
            list.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
            if (!tries) score++;
            feedback.className = 'quiz__feedback is-correct';
            feedback.textContent = tries ? 'Correct. You got it this time.' : 'Correct. Well done.';
            next.hidden = false;
          } else {
            tries++;
            btn.disabled = true;
            btn.classList.add('is-wrong');
            feedback.className = 'quiz__feedback is-wrong';
            void feedback.offsetWidth;
            feedback.classList.add('is-pulse');
            feedback.textContent = wrongLines[(tries - 1) % wrongLines.length];
          }
        });
        li.appendChild(btn);
        list.appendChild(li);
      });

      next.addEventListener('click', function () {
        card.hidden = true;
        current++;
        if (current < cards.length) {
          show(cards[current]);
        } else {
          root.querySelector('[data-quiz-score]').textContent = score;
          root.querySelector('[data-quiz-verdict]').textContent =
            score === perRound ? 'A true Madeirense. Every answer right at the first try.'
            : score >= perRound * .7 ? 'Impressive. You know the island better than most visitors.'
            : score >= perRound * .4 ? 'A solid showing. The island still holds a few secrets for you.'
            : 'Plenty left to discover. Our History section is a good place to start.';
          show(result);
        }
      });

      [count, question, list, feedback, actions].forEach(function (n) { card.appendChild(n); });
      return card;
    }

    function start(focus) {
      current = 0; score = 0;
      holder.textContent = '';
      cards = shuffle(pool).slice(0, perRound).map(buildCard);
      cards.forEach(function (c) { holder.appendChild(c); });
      result.hidden = true;
      if (focus) {
        show(cards[0]);
      } else {
        cards[0].hidden = false;
      }
    }

    root.querySelector('[data-quiz-restart]').addEventListener('click', function () { start(true); });
    start(false);
  })();
</script>
{% endblock %}
