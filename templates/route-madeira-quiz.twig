{% extends '@base.twig' %}

{# The Madeira Quiz at /madeira-quiz, linked from the header's "More" dropdown.
   Each round draws {{ per_round }} random questions from the pool in the
   quiz-data script below and shuffles their options.
   Add a question: one line { "q": question, "o": [right answer, wrong, wrong] }.
   The right answer always goes first; the page shuffles the order.
   Keep all three options alike: no brackets, extra detail or length only on the right one. #}
{% set per_round = 10 %}

{% block head %}
  <title>Madeira Quiz | How Well Do You Know the Island? - Times of Madeira</title>
  <meta name="description" content="Test your knowledge of Madeira's history, nature, food and traditions with the Times of Madeira quiz.">

  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.timesofmadeira.com/madeira-quiz">
  <meta property="og:site_name" content="Times of Madeira">
  <meta property="og:title" content="Madeira Quiz | How Well Do You Know the Island?">
  <meta property="og:description" content="Test your knowledge of Madeira's history, nature, food and traditions with the Times of Madeira quiz.">
  <meta property="og:image" content="https://www.timesofmadeira.com/media/madeira-flag.webp">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Madeira Quiz | How Well Do You Know the Island?">
  <meta name="twitter:description" content="Test your knowledge of Madeira's history, nature, food and traditions with the Times of Madeira quiz.">
  <meta name="twitter:image" content="https://www.timesofmadeira.com/media/madeira-flag.webp">
{% endblock %}

{% block body %}
<!-- begin hero: same Times of Madeira logo as on / -->
<section class="hero">
  <div class="container">
    <div class="row">
      <div class="col col-12">
        <div class="hero__inner">
          <div><a href="https://www.timesofmadeira.com" title="Madeira News | Times of Madeira">
              <img src="https://www.timesofmadeira.com/media/times-of-madeira.svg" alt="Madeira News | Times of Madeira">
          </a></div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- end hero -->

<main role="main" class="quiz-page">
  <div class="container">
    <div class="row">
      <div class="col col-12">
        <article class="quiz" data-quiz data-per-round="{{ per_round }}">
          <header class="quiz__masthead">
            <h1 class="quiz__title">How Well Do You Know Madeira?</h1>
            <p class="quiz__dek">{{ per_round }} questions on the island's history, nature, food and traditions, drawn fresh each round. Pick an answer; if it is wrong, try again.</p>
          </header>

          <div data-quiz-cards></div>

          <noscript><p class="quiz__dek">Please enable JavaScript to take the quiz.</p></noscript>

          <section class="quiz__card quiz__result" data-quiz-result hidden aria-live="polite">
            <p class="quiz__count">Your result</p>
            <p class="quiz__score"><span data-quiz-score>0</span><span class="quiz__score-of">/{{ per_round }}</span></p>
            <p class="quiz__verdict" data-quiz-verdict></p>
            <p class="quiz__note">Answers right at the first attempt.</p>
            <div class="quiz__actions">
              <button type="button" class="quiz__next quiz__next--ghost" data-quiz-restart>Play a new round</button>
              <a class="quiz__next" href="/tag/history">Read Madeira's history</a>
            </div>
          </section>
        </article>
      </div>
    </div>
  </div>
</main>

