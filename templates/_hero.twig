<!-- begin hero strip: newsletter left, Today in Madeira right -->
<section class="hero-strip">
  <div class="container">
    <div class="row">

      <div class="col col-6 col-t-12">
        <div class="strip-box strip-newsletter">
          <span class="strip-label">Newsletter</span>
          <hyvor-post-form newsletter="times-of-madeira" lists-hidden></hyvor-post-form>
        </div>
      </div>

      <div class="col col-6 col-t-12">
        <div class="strip-box today" id="today-madeira">
          <span class="strip-label">Today in Madeira</span>
          <ul class="today__list">
            <li class="today__item">
              <i aria-hidden="true">{{ icon('ionicons', 'partly-sunny-outline', 18) }}</i>
              <span class="today__name">Funchal</span>
              <span class="today__value" data-today="weather">&mdash;</span>
            </li>
            <li class="today__item">
              <i aria-hidden="true">{{ icon('ionicons', 'airplane-outline', 18) }}</i>
              <span class="today__name">Airport</span>
              <span class="today__value" data-today="airport">&mdash;</span>
            </li>
            <li class="today__item">
              <i aria-hidden="true">{{ icon('ionicons', 'boat-outline', 18) }}</i>
              <span class="today__name">Sea</span>
              <span class="today__value" data-today="sea">&mdash;</span>
            </li>
            <li class="today__item today__alert" data-today="alert-row" style="display:none">
              <i aria-hidden="true">{{ icon('ionicons', 'warning-outline', 18) }}</i>
              <span class="today__name">Alerts</span>
              <span class="today__value today__chips" data-today-chips></span>
            </li>
          </ul>
          <div class="today__foot">
            <a href="https://www.aeroportomadeira.pt/en/fnc/flights-destinations/find-flights/real-time-arrivals" target="_blank" rel="noopener">Live arrivals</a>
            <span data-today="updated"></span>
            <a href="https://ifcn.madeira.gov.pt/en/atividades-de-natureza/percursos-pedestres-recomendados/percursos-pedestres-recomendados.html" target="_blank" rel="noopener">Closed Trails</a>
            <a href="https://www.ipma.pt/en/" target="_blank" rel="noopener">Alerts: IPMA</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
<!-- end hero strip -->

<script>
// Today in Madeira: live weather in Funchal, wind at the airport, sea state.
// Open-Meteo is free, keyless and CORS-open; on failure the dashes stay.
(function () {
  var box = document.getElementById('today-madeira');
  if (!box) return;
  function set(key, text) {
    var el = box.querySelector('[data-today="' + key + '"]');
    if (el) el.textContent = text;
  }
  function sky(code) {
    if (code === 0) return 'Clear';
    if (code <= 2) return 'Partly cloudy';
    if (code === 3) return 'Overcast';
    if (code <= 48) return 'Fog';
    if (code <= 57) return 'Drizzle';
    if (code <= 67) return 'Rain';
    if (code <= 77) return 'Snow on peaks';
    if (code <= 82) return 'Showers';
    return 'Thunderstorms';
  }
  var tz = '&timezone=Atlantic%2FMadeira';
  // Two locations in one call: Funchal, then Madeira Airport (FNC).
  var weather = 'https://api.open-meteo.com/v1/forecast?latitude=32.65,32.6979&longitude=-16.91,-16.7745'
    + '&current=temperature_2m,weather_code,wind_speed_10m,wind_gusts_10m' + tz;
  var marine = 'https://marine-api.open-meteo.com/v1/marine?latitude=32.62&longitude=-16.92'
    + '&current=wave_height,sea_surface_temperature' + tz;

  fetch(weather).then(function (r) { return r.json(); }).then(function (d) {
    var town = d[0].current, fnc = d[1].current;
    set('weather', Math.round(town.temperature_2m) + '°C · ' + sky(town.weather_code));
    // Wind gusts at FNC. Around 25 kt (46 km/h), landings start to get diverted.
    var gusts = fnc.wind_gusts_10m;
    set('airport', Math.round(gusts) + ' km/h · '
      + (gusts >= 46 ? 'Strong wind, check your flight' : 'Light wind'));
    set('updated', 'Updated ' + town.time.slice(11, 16));
  }).catch(function () {});

  fetch(marine).then(function (r) { return r.json(); }).then(function (d) {
    var c = d.current;
    set('sea', 'Waves ' + c.wave_height.toFixed(1) + ' m · Water ' + Math.round(c.sea_surface_temperature) + '°C');
  }).catch(function () {});

  // Weather alerts: IPMA open-data warnings for Madeira's four forecast areas.
  // Free, keyless, CORS-open. The row and chips stay hidden while every area is green.
  var ALERT_AREAS = { MCN: 'North Coast', MCS: 'South Coast', MRM: 'Mountains', MPS: 'Porto Santo' };
  var ALERT_RANK = { green: 0, yellow: 1, orange: 2, red: 3 };
  var ALERT_TYPE = {
    'Precipitação': 'Rain', 'Vento': 'Wind', 'Agitação Marítima': 'Sea swell',
    'Trovoada': 'Thunderstorms', 'Nevoeiro': 'Fog', 'Neve': 'Snow',
    'Tempo Quente': 'Heat', 'Tempo Frio': 'Cold'
  };

  fetch('https://api.ipma.pt/open-data/forecast/warnings/warnings_www.json').then(function (r) {
    return r.json();
  }).then(function (data) {
    var now = new Date();
    var byArea = {};
    Object.keys(ALERT_AREAS).forEach(function (code) { byArea[code] = { level: 'green', types: [], upcoming: false, startTime: null }; });

    var LEAD_TIME = 8 * 60 * 60 * 1000; // show alerts starting within the next 8 hours, not just active ones

    data.forEach(function (w) {
      var area = byArea[w.idAreaAviso];
      if (!area) return;
      var starts = new Date(w.startTime);
      if (starts - now > LEAD_TIME || new Date(w.endTime) < now) return;
      var upcoming = starts > now;
      if (ALERT_RANK[w.awarenessLevelID] > ALERT_RANK[area.level]) {
        area.level = w.awarenessLevelID;
        area.types = [w.awarenessTypeName];
        area.upcoming = upcoming;
        area.startTime = starts;
      } else if (w.awarenessLevelID === area.level) {
        if (area.types.indexOf(w.awarenessTypeName) === -1) area.types.push(w.awarenessTypeName);
        if (upcoming && starts < area.startTime) { area.upcoming = true; area.startTime = starts; }
        if (!upcoming) area.upcoming = false;
      }
    });

    var maxLevel = 'green';
    Object.keys(byArea).forEach(function (code) {
      if (ALERT_RANK[byArea[code].level] > ALERT_RANK[maxLevel]) maxLevel = byArea[code].level;
    });

    if (maxLevel === 'green') return; // nothing above green anywhere on the island

    var row = box.querySelector('[data-today="alert-row"]');
    var chips = box.querySelector('[data-today-chips]');

    row.classList.add('today__alert--' + maxLevel);
    row.style.display = 'flex';

    chips.innerHTML = '';
    Object.keys(ALERT_AREAS).forEach(function (code) {
      var a = byArea[code];
      var levelLabel = a.level.charAt(0).toUpperCase() + a.level.slice(1);
      var types = a.types.map(function (t) { return ALERT_TYPE[t] || t; });
      var when = a.upcoming && a.startTime
        ? ' · from ' + a.startTime.toTimeString().slice(0, 5)
        : '';

      var chip = document.createElement('a');
      chip.className = 'today__chip today__chip--' + a.level;
      chip.title = levelLabel + (types.length ? ' · ' + types.join(', ') : ' · No warnings') + when;
      chip.href = 'https://www.ipma.pt/en/otempo/prev-sam/?p=' + code;
      chip.target = '_blank';
      chip.rel = 'noopener';
      chip.textContent = ALERT_AREAS[code];

      chips.appendChild(chip);
    });
  }).catch(function () {});
})();
</script>


<script>
// Array of slogans
var slogans = [
    "Madeira news, wrapped in context.",
    "Madeira news. Be political!",
    "Be informed, be engaged & demand better from your leaders.",
    "Madeira in scope. Know more, understand better.",
    "News from Madeira Island.",
    "No democracy without civic engagement.",
    "Read more!",
    "Eternal vigilance is the price of liberty.",
    "Power concedes nothing without a demand.",
    "Freedom is participation in power.",

];

// Function to select a random slogan and display it
function showRandomSlogan() {
    var sloganContainer = document.getElementById('slogan');
    var randomIndex = Math.floor(Math.random() * slogans.length);
    sloganContainer.textContent = slogans[randomIndex];
}

// Call the function to display a slogan on page load
showRandomSlogan();
</script>