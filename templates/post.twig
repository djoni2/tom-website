{% extends '@base.twig' %}

{% block head %}
  {{ parent() }}

  {# NewsArticle structured data for Google (Top Stories, article rich results).
     Pages (_post.is_page) are not articles, so they get none.
     json_encode escapes "/" as "\/", so a "</script>" in a title cannot close the tag. #}
  {% if not _post.is_page %}
    {# The name is fixed: _blog.name holds the SEO title "Madeira News, ... | Times of Madeira". #}
    {% set ld_publisher = {
      '@type': 'NewsMediaOrganization',
      'name': 'Times of Madeira',
      'url': 'https://www.timesofmadeira.com',
      'logo': { '@type': 'ImageObject', 'url': _blog.logo_url ?: 'https://www.timesofmadeira.com/media/times-of-madeira.svg' }
    } %}

    {% set ld_authors = [] %}
    {% for author in _post.authors %}
      {% set ld_authors = ld_authors|merge([{ '@type': 'Person', 'name': author.name, 'url': author.url }]) %}
    {% endfor %}

    {% set ld = {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      'mainEntityOfPage': { '@type': 'WebPage', '@id': _post.url },
      'url': _post.url,
      'headline': _post.title|slice(0, 110),
      'datePublished': _post.published_at|date('c'),
      'dateModified': (_post.updated_at > _post.published_at ? _post.updated_at : _post.published_at)|date('c'),
      'inLanguage': _lang.code,
      'author': ld_authors ?: [ld_publisher],
      'publisher': ld_publisher,
      'isAccessibleForFree': true
    } %}

    {% if _post.description %}
      {% set ld = ld|merge({ 'description': _post.description }) %}
    {% endif %}
    {% if _post.featured_image_url %}
      {% set ld = ld|merge({ 'image': [_post.featured_image_url] }) %}
    {% endif %}
    {% if _post.tags|length %}
      {% set ld = ld|merge({ 'articleSection': _post.tags[0].name, 'keywords': _post.tags|map(t => t.name)|join(', ') }) %}
    {% endif %}
    {% if _post.words %}
      {% set ld = ld|merge({ 'wordCount': _post.words }) %}
    {% endif %}

    <script type="application/ld+json">{{ ld|json_encode|raw }}</script>
  {% endif %}
{% endblock %}

{% block body %}




  <main role="main">

    <div class="container">
      <div class="post-head">
	  <div class="col col-12">
        <div class="hero__inner">
           
        <div><a href="https://www.timesofmadeira.com" title="Times of Madeira"> <img src="https://www.timesofmadeira.com/media/times-of-madeira.svg" alt="Madeira News">   </a></div>
           
        </div>
      </div>
        {% if _post.featured_image_url and _config.settings.post.featured_image %}
          <div class="image-box">
            <img src="{{ _post.featured_image_url }}" alt="{{ _post.title }}" class="post-image" loading="lazy">
          </div>
        {% endif %}

        <div class="post-head__inner">
          <div class="post__meta">
            {% if (_config.settings.loop.tags) %}
              <div class="post__tags">
                {% for tag in _post.tags %}
                  <a href="{{ tag.url }}" class="post__tag">{{ tag.name }}</a>
                {% endfor %}
              </div>
            {% endif %}
            <time class="post__date" datetime="{{ _post.published_at | date('d-m-Y') }}">
              {{ _post.published_at | format_date('medium', locale=_lang.code) }}
            </time>
          </div>

          <h1 class="post-title">{{ _post.title }}</h1>

          {% if _post.description %}
            <p class="post-description">{{ _post.description }}</p>
          {% endif %}
        </div>

      </div>
    </div>

    <div class="container">
      <!-- begin post -->
      <article class="post">

        <section class="post-content">
          {{ _post.content | raw }}
        </section>
          
         
          
          
          
         
        <div>
<br><br>
           

 <p style="text-align:center;">
  <a
    href="https://blogs.hyvor.com?partner=timesofmadeira"
    target="_blank"
    rel="noopener"
    style="
      display: inline-block;
      background-color: #000;
      color: #fff;
      padding: 5px 20px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: bold;
      font-family: sans-serif;
      transition: all 0.25s ease;
    "
    onmouseover="this.style.backgroundColor='#c91400';"
    onmouseout="this.style.backgroundColor='#000';"
  >
    Times of Madeira runs on Hyvor ✍️ 
  </a>
  <br>
  <a>a fast ⚡ modern publishing platform.</a>
</p>
 </div>
       


          
          
          


        {% if _route.name != 'page' %}

          {% if _newsletter %}
            <section class="newsletter-box">
              <h3>{{ 'newsletter' | lang }}</h3>
              <div>
                {{ _newsletter | template }}
              </div>
            </section>
          {% endif %}

          {% if _comments %}
            <section class="comments-box">
              <h3>{{ 'comments' | lang }}</h3>
                

                
              <div>{{ _comments | template }}</div>
            </section>
          {% endif %}

        {% endif %}
      </article>
      <!-- end post -->
    </div>
      
           
   
   

      
      
  </main>



{% endblock %}