{% extends '@base.twig' %}

{# Section pages: the main newspaper sections get a "Start here" row and
   CollectionPage structured data. Pilot on dev: Politics and Tourism. #}
{% set section_picks = {
  'politics': [
    'king-of-madeira-alberto-joao-jardims-37-year-legacy-of-power',
    'babylon-madeira-12-months-of-scandals',
    'can-a-court-lift-president-albuquerques-immunity',
    'rhetoric-vs-reality-chegas-push-for-a-fourth-republic'
  ],
  'tourism': [
    'madeira-by-bus-public-transport-in-madeira',
    'rent-a-car-madeira-no-credit-card',
    'how-to-buy-your-madeira-hiking-trail-ticket-with-simplifica',
    'colossus-the-rise-and-fall-of-madeiras-hotel-atlantis'
  ]
} %}

{% block head %}
  {{ parent() }}

  {% if section_picks[_tag.slug] is defined %}
    {% set ld = {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      'name': _tag.name|capitalize ~ ' - Times of Madeira',
      'url': _tag.url,
      'isPartOf': { '@type': 'WebSite', 'name': 'Times of Madeira', 'url': 'https://www.timesofmadeira.com' },
      'breadcrumb': {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          { '@type': 'ListItem', 'position': 1, 'name': 'Times of Madeira', 'item': 'https://www.timesofmadeira.com' },
          { '@type': 'ListItem', 'position': 2, 'name': _tag.name|capitalize, 'item': _tag.url }
        ]
      }
    } %}
    {% if _tag.description %}
      {% set ld = ld|merge({ 'description': _tag.description }) %}
    {% endif %}
    <script type="application/ld+json">{{ ld|json_encode|raw }}</script>
  {% endif %}
{% endblock %}

{% block body %}
<main role="main" class="tag-page">
    
  <!-- begin hero -->
<section class="hero">
    
  <div class="container">
    <div class="row">
      <div class="col col-12">
        <div class="hero__inner">
           
        <div><a href="https://www.timesofmadeira.com" title="Times of Madeira"> <img src="https://www.timesofmadeira.com/media/times-of-madeira.svg" alt="Times of Madeira">   </a></div>
           
        </div>
      </div>
    </div>
  </div>
</section>
<!-- end hero -->  
    
    
  <div class="container">
    <div class="row">
      <div  class="col col-12">
          
          
          
          <section class="tag-head">
  {% if _tag.name == "Politics" %}
    <h1 class="tag-title tag-title--politics">Times of Madeira | Politics</h1>
    <div class="tag-description tag-description--politics">
      <p>Madeira's political landscape has undergone significant changes over time. As an autonomous region of Portugal, Madeira has its own regional government and parliament, allowing for self-rule in many areas. The <b>Social Democratic Party (PSD)</b> has traditionally dominated local politics, but in recent years, the Socialist Party (PS) and other smaller parties have gained influence, shaping policy in areas like tourism, economic development, and social welfare.</p> 
        
        <p> Political dynamics continue to evolve, reflecting both local concerns and broader national trends in Portugal, with governance adapting to the region's changing needs and challenges. Stay informed about the latest developments in Madeira's political landscape. Get breaking Madeira news on government decisions, political party activities, and laws impacting the island. Engage in the political circus!</p> 
    </div>
  {% elseif _tag.name == "Culture" %}
    <h1 class="tag-title tag-title--culture">Times of Madeira | Culture</h1>
    <div class="tag-description tag-description--culture">Culture in Madeira.</div>
              
    {% elseif _tag.name == "Funchal" %}
    <h1 class="tag-title tag-title--culture">Times of Madeira | Funchal News</h1>
    <div class="tag-description tag-description--culture">News from Funchal. Madeira's capital. It's where things are happening!</div>
              
              
          {% else %}
    <h1 class="tag-title">{{ _tag.name }}</h1>
    {% if _tag.description %}
      <div class="tag-description">{{ _tag.description }}</div>
    {% endif %}    
            

  
              
  {% endif %}
</section>

          {% if section_picks[_tag.slug] is defined and _pagination.page == 1 %}
            {% set start_here = data(endpoint="posts", filter=section_picks[_tag.slug]|map(slug => 'slug=' ~ slug)|join('|'), limit=4).data %}
            {# Fallback while picks are missing (e.g. on the dev blog): the tag's longest articles. #}
            {% if start_here|length < 4 %}
              {% set start_here = data(endpoint="posts", filter="tag.slug=" ~ _tag.slug, sort="words DESC", limit=4).data %}
            {% endif %}

            {% if start_here|length %}
              <section class="start-here" aria-label="Start here">
                <h2 class="start-here__title">Start here</h2>
                <div class="related__grid related__grid--4">
                  {% for post in start_here %}
                    <a class="related__card" href="{{ post.url }}">
                      {% if post.featured_image_url %}
                        <img class="related__image" src="{{ post.featured_image_url }}" alt="{{ post.title }}" loading="lazy">
                      {% else %}
                        <span class="related__image related__image--empty"></span>
                      {% endif %}
                      <span class="related__name">{{ post.title }}</span>
                    </a>
                  {% endfor %}
                </div>
              </section>
            {% endif %}
          {% endif %}

          
          
          
          
          
      </div>
    </div>
  </div>

  <div class="container">
    <div class="section-title">
      {{ 'check_out_posts' | lang }}
      <span>
        {{ _pagination.total | lang_by_number(
          zero="posts_num_zero",
          one="posts_num_one",
          multi="posts_num_multi"
        )}}
      </span>
    </div>
    <div class="row">
      {% include '_loop.twig' %}
    </div>
  </div>

  {% include '_pagination.twig' %}
</main>

{% endblock %}