<!-- begin header -->
<header class="header">
    <div id="top-div"></div>

  <div class="container-big">
    <div class="row">
      <div class="header__inner col col-12">
<div class="footer__social">
            {% include '_social.twig' with { social: _blog.social } %}
          </div>
        <div class="header__date">
          {{ "now"|date("l, F j, Y") }}
        </div>
        <div class="logo" aria-label="Times of Madeira">
         </div>
		 

        <div class="hamburger" onclick="menuToggle()" id="hamburger" aria-expanded="false" aria-controls="menuList">
          <div></div>
        </div>

        <div class="nav-overlay" id="navOverlay" onclick="menuToggle()"></div>

        <nav class="main-nav" aria-label="Main menu" id="menuList">
          <div class="nav-drawer__head">
            <div class="nav-drawer__brand">
              <span class="nav-drawer__title">Times of Madeira</span>
              <span class="nav-drawer__date">{{ "now"|date("l, F j, Y") }}</span>
            </div>
            <div class="nav-search">
              <a class="nav-search-button" aria-label="Search"><i aria-hidden="true">{{ icon('ionicons', 'search', 16) }}</i></a>
            </div>
          </div>

          <div class="main-nav__box">
            <ul class="nav__list list-reset">
              {# The newsletter and contact items move into the "More" dropdown (_sections-nav.twig uses the same test) #}
              {% for nav in _blog.nav_header|filter(n => not (n.url ends with '/contact' or 'newsletter' in n.url)) %}
                <li class="nav__item">
                  <a href="{{ nav.url }}" class="nav__link nav__{{ nav.name | lower | slug }}{% if is_current_url(nav.url) %} active-link{% endif %}">{{ nav.name }}</a>
                </li>
              {% endfor %}
              {% include '_sections-nav.twig' %}
            </ul>

            {# Flat, always-visible, independently-scrollable groups used only inside the mobile drawer #}
            {% include '_sections-nav.twig' with { mode: 'drawer' } %}
          </div>

          <div class="nav-button">
            {% if (_blog.color_modes == 'both') %}
            <div class="color-mode-toggler">
              <a onclick="_hb.changeColorMode('light')">{{ icon('ionicons', 'sunny', 14) }} <span>Light</span></a>
              <a onclick="_hb.changeColorMode('dark')">{{ icon('ionicons', 'moon', 14) }} <span>Dark</span></a>
            </div>
            {% endif %}

            {% if _blog.languages | length > 1 %}
            <div class="nav-lang">
              <a class="lang-label" role="label" onclick="toggleLanguageDropdown()">
                {{ icon('ionicons', 'earth', 14) }}&nbsp;<span>{{ _lang.name }}</span>
              </a>
              <div id="lang-selector">
              {% for lang in _blog.languages %}
                <a href="{{ lang.code | language_variant_url }}" class="{% if lang.code == _lang.code %}active{% endif %}">{{ lang.name }}
                </a>
              {% endfor %}
              </div>
              <div id="lang-selector-closer" onclick="toggleLanguageDropdown()"></div>
            </div>
            {% endif %}

            <div class="nav-search">
              <a class="nav-search-button"><i aria-hidden="true">{{ icon('ionicons', 'search', 16) }}</i>
              </a>
            </div>
          </div>

        </nav>

      </div>
    </div>
  </div>

</header>
<!-- end header -->