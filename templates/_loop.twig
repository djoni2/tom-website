{% for post in _posts %}
  <div class="article col {% if loop.index == 2 %}col-6 col-w-4 col-d-6 col-t-12 article--big{% else %}col-3 col-w-4 col-d-6 col-t-12{% endif %}">

    {% if post.featured_image_url and _config.settings.loop.featured_image %}
    <a href="{{ post.url }}" class="article__image">
      {% if post.is_featured %}
        <span class="featured">IN FOCUS</span>
      {% endif %}
      <img src="{{ post.featured_image_url }}" alt="{{ post.title }}" loading="lazy">
    </a>
    {% endif %}

    <div class="article__inner">

      <div class="article__content">

        <div class="article__meta">
          {% if (_config.settings.loop.tags) %}
          <div class="article__tags">
            {% for tag in post.tags %}
              <a class="article__tag" href="{{ tag.url }}">{{ tag.name }}</a>
            {% endfor %}
          </div>
          {% endif %}
          <time class="article__date" datetime="{{ post.published_at | date('d-m-Y') }}">
            {{ post.published_at | format_date('medium', locale=_lang.code) }}
          </time>
        </div>

        <h2 class="article__title">
          <a href="{{ post.url }}">{{ post.title }}</a>
        </h2>

        {% if post.description %}
          <p class="article__description"; style="font-weight:300 !important;">{{ post.description }}</p>
        {% endif %}

        {% if (_config.settings.loop.authors) %}
        <div class="article__authors">
          <div class="article__author__avatar">
            {% for author in post.authors %}
              <a href="{{ author.url }}">
                {% if author.picture_url %}
                  <img src="{{ author.picture_url }}" alt="{{ author.name }}">
                {% endif %}
              </a>
            {% endfor %}
          </div>
          <div class="article__author">
            {% for author in post.authors %}
              <a href="{{ author.url }}" class="article__author__link">{{ author.name }}</a>{% if not loop.last %}, {% endif %}
            {% endfor %}
          </div>
        </div>
        {% endif %}

      </div>

    </div>
  </div>

  {# Full-width promo band. The first row is 3 cards (col-3 + col-6 + col-3),
     so this lands between row one and row two. On a short final page with
     fewer than 3 posts it falls after the last card instead of vanishing. #}
  {% if loop.index == 3 or (loop.last and loop.length < 3) %}
    <div class="col col-12" style="text-align:center; margin:10px 0 30px;">
      <a href="https://www.takemylead.de" target="_blank" style="color:var(--text-color); font-weight:300; text-decoration:none;">
        I make sure your project ranks on Google and gets leads!
      </a>
    </div>
  {% endif %}
{% endfor %}
