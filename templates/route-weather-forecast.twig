{% extends '@base.twig' %}

{# The Weather Forecast page at /weather-forecast, linked from the header's "More" dropdown.
   Forecasts are fetched client-side from Open-Meteo (no API key, free, CORS-enabled) for
   all 11 municipalities of the Madeira autonomous region, using the location list below.
   Add or edit a location: one line { "name": label, "lat": latitude, "lon": longitude }. #}

{% block head %}
  <title>Madeira Weather Forecast | 7-Day Outlook for Funchal, Calheta & More - Times of Madeira</title>
  <meta name="description" content="Live 7-day weather forecasts for Funchal, Calheta, Câmara de Lobos, Porto Santo and every municipality in Madeira, updated from Open-Meteo.">

  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.timesofmadeira.com/weather-forecast">
  <meta property="og:site_name" content="Times of Madeira">
  <meta property="og:title" content="Madeira Weather Forecast | 7-Day Outlook for Funchal, Calheta & More">
  <meta property="og:description" content="Live 7-day weather forecasts for Funchal, Calheta, Câmara de Lobos, Porto Santo and every municipality in Madeira, updated from Open-Meteo.">
  <meta property="og:image" content="https://www.timesofmadeira.com/media/funchal-sunset-view.webp">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Madeira Weather Forecast | 7-Day Outlook for Funchal, Calheta & More">
  <meta name="twitter:description" content="Live 7-day weather forecasts for Funchal, Calheta, Câmara de Lobos, Porto Santo and every municipality in Madeira, updated from Open-Meteo.">
  <meta name="twitter:image" content="https://www.timesofmadeira.com/media/funchal-sunset-view.webp">
{% endblock %}

{% block body %}
<main role="main" class="weather-page">
  <div class="container">
    <div class="row">
      <div class="col col-12">
        <header class="weather__masthead">
          <a href="https://www.timesofmadeira.com" title="Madeira News | Times of Madeira" class="weather__logo">
            <img src="https://www.timesofmadeira.com/media/times-of-madeira.svg" alt="Madeira News | Times of Madeira">
          </a>
          <h1 class="weather__title">Madeira Weather Forecast</h1>
          <p class="weather__dek">The 7-day outlook for Funchal, Calheta and every other municipality on the island, straight from live forecast data. Pick an area below.</p>
        </header>

        <section class="weather__alerts" aria-live="polite">
          <h2 class="weather__alerts-title">IPMA Weather Alerts</h2>
          <div class="weather__alerts-grid" data-weather-alerts>
            <p class="weather__alerts-status" data-weather-alerts-status>Checking IPMA warnings&hellip;</p>
          </div>

          <div class="weather__alerts-legend">
            <h3 class="weather__alerts-legend-title">What yellow, orange and red mean</h3>
            <dl class="weather__alerts-legend-list">
              <div class="weather__alerts-legend-item weather__alerts-legend-item--yellow">
                <dt>Yellow</dt>
                <dd>Be aware. Weather could pose a risk for specific activities, such as hiking, boating or driving on exposed roads.</dd>
              </div>
              <div class="weather__alerts-legend-item weather__alerts-legend-item--orange">
                <dt>Orange</dt>
                <dd>Be prepared. Weather is dangerous. Expect damage, travel disruption and some risk to people and property.</dd>
              </div>
              <div class="weather__alerts-legend-item weather__alerts-legend-item--red">
                <dt>Red</dt>
                <dd>Take action. Extreme weather is expected, with a serious risk to life and property. Follow Civil Protection guidance.</dd>
              </div>
            </dl>
            <p class="weather__alerts-source">Alerts are issued by <strong><a href="https://www.ipma.pt/en/" rel="noopener" target="_blank">IPMA</a></strong>, Portugal&rsquo;s state sea and weather institute (Instituto Português do Mar e Atmosfera). IPMA tracks conditions across Madeira&rsquo;s four forecast areas &mdash; the north coast, the south coast, the mountains and Porto Santo &mdash; and raises a yellow, orange or red warning whenever rain, wind, sea swell or another hazard is expected to cross that area&rsquo;s threshold.</p>
          </div>
        </section>

        <div class="weather__tabs" role="tablist" aria-label="Choose an area" data-weather-tabs></div>

        <div class="weather__days" data-weather-days aria-live="polite">
          <p class="weather__status" data-weather-status>Loading forecast&hellip;</p>
        </div>

        <p class="weather__attribution">Weather data by <strong><a href="https://open-meteo.com/" rel="noopener" target="_blank">Open-Meteo.com</a></strong>. Forecasts can change; always check closer to your plans.</p>
      </div>
    </div>
  </div>
</main>

<script type="application/json" id="weather-data">
[
  {"name":"Funchal","lat":32.6669,"lon":-16.9241},
  {"name":"Câmara de Lobos","lat":32.6456,"lon":-16.9753},
  {"name":"Ribeira Brava","lat":32.6578,"lon":-17.0656},
  {"name":"Ponta do Sol","lat":32.6778,"lon":-17.1011},
  {"name":"Calheta","lat":32.7167,"lon":-17.1833},
  {"name":"Porto Moniz","lat":32.8667,"lon":-17.1667},
  {"name":"São Vicente","lat":32.8,"lon":-17.05},
  {"name":"Santana","lat":32.8028,"lon":-16.8822},
  {"name":"Machico","lat":32.7167,"lon":-16.7667},
  {"name":"Santa Cruz","lat":32.6883,"lon":-16.7883},
  {"name":"Porto Santo","lat":33.0586,"lon":-16.3378}
]
</script>

<script>
  (function () {
    var root = document.querySelector('.weather-page');
    if (!root) return;
    var locations = JSON.parse(document.getElementById('weather-data').textContent);
    var tabs = root.querySelector('[data-weather-tabs]');
    var days = root.querySelector('[data-weather-days]');
    var status = root.querySelector('[data-weather-status]');
    var cache = {};
    var current = 0;

    var weatherText = {
      0: ['Clear sky', '☀️'],
      1: ['Mainly clear', '🌤️'],
      2: ['Partly cloudy', '⛅'],
      3: ['Overcast', '☁️'],
      45: ['Fog', '🌫️'],
      48: ['Fog', '🌫️'],
      51: ['Light drizzle', '🌦️'],
      53: ['Drizzle', '🌦️'],
      55: ['Dense drizzle', '🌦️'],
      56: ['Freezing drizzle', '🌧️'],
      57: ['Freezing drizzle', '🌧️'],
      61: ['Light rain', '🌧️'],
      63: ['Rain', '🌧️'],
      65: ['Heavy rain', '🌧️'],
      66: ['Freezing rain', '🌧️'],
      67: ['Freezing rain', '🌧️'],
      71: ['Light snow', '🌨️'],
      73: ['Snow', '🌨️'],
      75: ['Heavy snow', '🌨️'],
      77: ['Snow grains', '🌨️'],
      80: ['Rain showers', '🌦️'],
      81: ['Rain showers', '🌦️'],
      82: ['Violent showers', '⛈️'],
      85: ['Snow showers', '🌨️'],
      86: ['Snow showers', '🌨️'],
      95: ['Thunderstorm', '⛈️'],
      96: ['Thunderstorm, hail', '⛈️'],
      99: ['Thunderstorm, hail', '⛈️']
    };

    function describe(code) {
      return weatherText[code] || ['Mixed conditions', '🌤️'];
    }

    function el(tag, cls, text) {
      var n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    }

    function dayLabel(dateStr, index) {
      if (index === 0) return 'Today';
      var d = new Date(dateStr + 'T12:00:00');
      return d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
    }

    function renderLocation(index) {
      current = index;
      tabs.querySelectorAll('.weather__tab').forEach(function (btn, i) {
        var active = i === index;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      var loc = locations[index];
      if (cache[loc.name]) {
        renderDays(cache[loc.name]);
        return;
      }

      days.innerHTML = '';
      status.hidden = false;
      status.textContent = 'Loading forecast for ' + loc.name + '…';

      var url = 'https://api.open-meteo.com/v1/forecast?latitude=' + loc.lat + '&longitude=' + loc.lon +
        '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max' +
        '&timezone=Atlantic%2FMadeira&forecast_days=7';

      fetch(url)
        .then(function (res) { if (!res.ok) throw new Error('bad response'); return res.json(); })
        .then(function (data) {
          cache[loc.name] = data.daily;
          if (current === index) renderDays(data.daily);
        })
        .catch(function () {
          if (current === index) {
            status.hidden = false;
            status.textContent = 'Could not load the forecast for ' + loc.name + '. Please try again shortly.';
          }
        });
    }

    function renderDays(daily) {
      status.hidden = true;
      days.innerHTML = '';
      daily.time.forEach(function (date, i) {
        var info = describe(daily.weather_code[i]);
        var card = el('div', 'weather__day');
        card.appendChild(el('p', 'weather__day-label', dayLabel(date, i)));
        card.appendChild(el('p', 'weather__icon', info[1]));
        card.appendChild(el('p', 'weather__condition', info[0]));
        var temps = el('p', 'weather__temps');
        temps.appendChild(el('span', 'weather__high', Math.round(daily.temperature_2m_max[i]) + '°'));
        temps.appendChild(el('span', 'weather__low', Math.round(daily.temperature_2m_min[i]) + '°'));
        card.appendChild(temps);
        var rain = daily.precipitation_probability_max[i];
        card.appendChild(el('p', 'weather__rain', '💧 ' + (rain == null ? '–' : rain + '%')));
        days.appendChild(card);
      });
    }

    locations.forEach(function (loc, i) {
      var btn = el('button', 'weather__tab', loc.name);
      btn.type = 'button';
      btn.setAttribute('role', 'tab');
      btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      btn.addEventListener('click', function () { renderLocation(i); });
      tabs.appendChild(btn);
    });
    tabs.querySelector('.weather__tab').classList.add('is-active');

    renderLocation(0);
  })();
</script>

<script>
// IPMA open-data warnings for Madeira's four forecast areas. Free, keyless, CORS-open.
// Shows every active or upcoming (non-green) warning per area, with its own time window.
(function () {
  var grid = document.querySelector('[data-weather-alerts]');
  if (!grid) return;
  var status = grid.querySelector('[data-weather-alerts-status]');

  var AREAS = [
    { code: 'MCN', name: 'North Coast' },
    { code: 'MCS', name: 'South Coast' },
    { code: 'MRM', name: 'Mountains' },
    { code: 'MPS', name: 'Porto Santo' }
  ];
  var TYPE_NAME = {
    'Precipitação': 'Rain', 'Vento': 'Wind', 'Agitação Marítima': 'Sea swell',
    'Trovoada': 'Thunderstorms', 'Nevoeiro': 'Fog', 'Neve': 'Snow',
    'Tempo Quente': 'Heat', 'Tempo Frio': 'Cold'
  };
  var LEVEL_NAME = { yellow: 'Yellow', orange: 'Orange', red: 'Red' };

  function fmt(date) {
    var day = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
    var time = date.toTimeString().slice(0, 5);
    return day + ', ' + time;
  }

  function timeRange(start, end) {
    var sameDay = start.toDateString() === end.toDateString();
    if (sameDay) {
      return start.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) + ', '
        + start.toTimeString().slice(0, 5) + '–' + end.toTimeString().slice(0, 5);
    }
    return fmt(start) + ' – ' + fmt(end);
  }

  fetch('https://api.ipma.pt/open-data/forecast/warnings/warnings_www.json').then(function (r) {
    return r.json();
  }).then(function (data) {
    var now = new Date();
    grid.innerHTML = '';

    AREAS.forEach(function (area) {
      var warnings = data
        .filter(function (w) { return w.idAreaAviso === area.code && w.awarenessLevelID !== 'green' && new Date(w.endTime) > now; })
        .sort(function (a, b) { return new Date(a.startTime) - new Date(b.startTime); });

      var card = el('div', 'weather__alert-card');
      var topLevel = warnings.length ? warnings.reduce(function (max, w) {
        var rank = { yellow: 1, orange: 2, red: 3 };
        return rank[w.awarenessLevelID] > rank[max] ? w.awarenessLevelID : max;
      }, 'yellow') : 'green';
      card.classList.add('weather__alert-card--' + topLevel);

      var head = el('div', 'weather__alert-card-head');
      head.appendChild(el('span', 'weather__alert-dot weather__alert-dot--' + topLevel));
      head.appendChild(el('h3', 'weather__alert-card-name', area.name));
      card.appendChild(head);

      if (!warnings.length) {
        card.appendChild(el('p', 'weather__alert-none', 'No warnings in place.'));
      } else {
        var list = el('ul', 'weather__alert-items');
        warnings.forEach(function (w) {
          var item = el('li', 'weather__alert-item weather__alert-item--' + w.awarenessLevelID);
          item.appendChild(el('span', 'weather__alert-item-level', LEVEL_NAME[w.awarenessLevelID] || w.awarenessLevelID));
          item.appendChild(el('span', 'weather__alert-item-type', TYPE_NAME[w.awarenessTypeName] || w.awarenessTypeName));
          item.appendChild(el('span', 'weather__alert-item-time', timeRange(new Date(w.startTime), new Date(w.endTime))));
          list.appendChild(item);
        });
        card.appendChild(list);
      }

      grid.appendChild(card);
    });
  }).catch(function () {
    status.hidden = false;
    status.textContent = 'Could not load IPMA warnings right now.';
  });
})();
</script>
{% endblock %}
