{# DEPENDING ON social variable #}

{% import "_macro.twig" as macro %}

{% if social.twitter %}{{ macro.social_icon_x(social.twitter) }}{% endif %}
{% if social.facebook %}{{ macro.social_icon("Facebook", social.facebook, 'logo-facebook') }}{% endif %}
{% if social.linkedin %}{{ macro.social_icon("Linkedin", social.linkedin, 'logo-linkedin') }}{% endif %}
{% if social.youtube %}{{ macro.social_icon("Youtube", social.youtube, 'logo-youtube') }}{% endif %}
{# The Threads URL is stored in Hyvor's TikTok field, hence social.tiktok here. #}
{% if social.tiktok %}{{ macro.social_icon_threads(social.tiktok) }}{% endif %}
{% if social.instagram %}{{ macro.social_icon("Instagram", social.instagram, 'logo-instagram') }}{% endif %}
{% if social.github %}{{ macro.social_icon("Github", social.github, 'logo-github') }}{% endif %}
