{# The two dropdowns at the end of the header menu: "Sections" and "More".
   All links stay in the HTML, so crawlers still see them.
   Sections: [label, tag slug], each linking to its tag page. #}
{% set sections = [
  ['Airport', 'airport'],
  ['Culture', 'culture'],
  ['Crime', 'crime'],
  ['Economy', 'economy'],
  ['Funchal', 'funchal'],
  ['History', 'history'],
  ['Politics', 'politics'],
  ['Public Transport', 'public-transport'],
  ['Society', 'society'],
  ['Tourism', 'tourism'],
  ['Traffic', 'traffic']
] %}

{# More: the newsletter and contact items from the Console menu (_header.twig leaves them out), then the Madeira Quiz #}
{% set more = _blog.nav_header|filter(n => n.url ends with '/contact' or 'newsletter' in n.url) %}

{% if mode == 'drawer' %}
  {# Flat, always-visible groups for the left-drawer mobile menu: a labelled,
     independently-scrollable Sections list (so 11 tags don't push the rest
     of the drawer off-screen) and a plain More list. #}
  <div class="nav-group">
    <div class="nav-group__label">Sections</div>
    <ul class="nav-group__scroll list-reset">
      {% for section in sections %}
        <li><a href="/tag/{{ section[1] }}" class="nav-group__link{% if _tag is defined and _tag.slug == section[1] %} is-active{% endif %}">{{ section[0] }}</a></li>
      {% endfor %}
    </ul>
  </div>

  <div class="nav-group">
    <div class="nav-group__label">More</div>
    <ul class="nav-group__list list-reset">
      {% for nav in more %}
        <li><a href="{{ nav.url }}" class="nav-group__link{% if is_current_url(nav.url) %} is-active{% endif %}">{{ 'newsletter' in nav.url ? 'Subscribe to the Newsletter' : nav.name }}</a></li>
      {% endfor %}
      <li><a href="/madeira-quiz" class="nav-group__link{% if is_current_url('/madeira-quiz') %} is-active{% endif %}">Madeira Quiz</a></li>
      <li><a href="/weather-forecast" class="nav-group__link{% if is_current_url('/weather-forecast') %} is-active{% endif %}">Weather Forecast</a></li>
    </ul>
  </div>
{% else %}
<li class="nav__item nav__item--dropdown">
  <details class="nav-dropdown nav-dropdown--sections">
    <summary class="nav__link nav-dropdown__toggle{% if _tag is defined and _tag.slug in sections|map(s => s[1]) %} active-link{% endif %}">
      Sections
      <svg class="nav-dropdown__chevron" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </summary>
    <ul class="nav-dropdown__list list-reset">
      {% for section in sections %}
        <li>
          <a href="/tag/{{ section[1] }}" class="nav-dropdown__link{% if _tag is defined and _tag.slug == section[1] %} is-active{% endif %}">{{ section[0] }}</a>
        </li>
      {% endfor %}
    </ul>
  </details>
</li>

<li class="nav__item nav__item--dropdown">
  <details class="nav-dropdown nav-dropdown--more">
    <summary class="nav__link nav-dropdown__toggle">
      More
      <svg class="nav-dropdown__chevron" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </summary>
    <ul class="nav-dropdown__list list-reset">
      {% for nav in more %}
        <li>
          <a href="{{ nav.url }}" class="nav-dropdown__link{% if is_current_url(nav.url) %} is-active{% endif %}">{{ 'newsletter' in nav.url ? 'Subscribe to the Newsletter' : nav.name }}</a>
        </li>
      {% endfor %}
      <li>
        <a href="/madeira-quiz" class="nav-dropdown__link{% if is_current_url('/madeira-quiz') %} is-active{% endif %}">Madeira Quiz</a>
      </li>
      <li>
        <a href="/weather-forecast" class="nav-dropdown__link{% if is_current_url('/weather-forecast') %} is-active{% endif %}">Weather Forecast</a>
      </li>
    </ul>
  </details>
</li>
{% endif %}

<script>
  // One dropdown open at a time; close on a click outside or on Escape.
  (function () {
    var all = function () { return document.querySelectorAll('.nav-dropdown'); };
    document.addEventListener('toggle', function (e) {
      if (!e.target.classList || !e.target.classList.contains('nav-dropdown') || !e.target.open) return;
      all().forEach(function (d) { if (d !== e.target) d.open = false; });
    }, true);
    document.addEventListener('click', function (e) {
      all().forEach(function (d) { if (d.open && !d.contains(e.target)) d.open = false; });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      all().forEach(function (d) { if (d.open) { d.open = false; d.querySelector('summary').focus(); } });
    });
  })();
</script>
